{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZKYT",
  "version": "0.25.1",
  "identifier": "com.kzeng.zkyt",
  "build": {
    "beforeDevCommand": "corepack pnpm run dev:tauri-renderer",
    "beforeBuildCommand": "corepack pnpm run pack:tauri",
    "devUrl": "http://localhost:9080",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ZKYT",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../_icons/icon.ico",
      "../_icons/iconMac.icns"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 25
    }
  }
}
